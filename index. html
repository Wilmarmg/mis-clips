<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mis Clips de Lives</title>
  <style>
    :root {
      --bg: #0e0e10;
      --card: #18181b;
      --card-hover: #222227;
      --accent: #9147ff;
      --text: #efeff1;
      --muted: #adadb8;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding: 20px;
    }

    header {
      max-width: 1100px;
      margin: 0 auto 24px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    h1 { font-size: 1.6rem; letter-spacing: -0.5px; }
    h1 span { color: var(--accent); }

    #search {
      background: var(--card);
      border: 1px solid #2f2f35;
      color: var(--text);
      padding: 10px 14px;
      border-radius: 8px;
      width: 100%;
      max-width: 300px;
      font-size: 0.95rem;
      outline: none;
    }
    #search:focus { border-color: var(--accent); }

    .filters {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .filter-btn {
      background: var(--card);
      color: var(--muted);
      border: 1px solid #2f2f35;
      padding: 6px 14px;
      border-radius: 20px;
      cursor: pointer;
      font-size: 0.85rem;
      transition: 0.2s;
    }
    .filter-btn.active, .filter-btn:hover {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }

    .grid {
      max-width: 1100px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
      gap: 18px;
    }

    .card {
      background: var(--card);
      border-radius: 12px;
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.2s, background 0.2s;
      border: 1px solid #26262c;
    }
    .card:hover {
      transform: translateY(-4px);
      background: var(--card-hover);
    }

    .thumb {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      background: linear-gradient(135deg, #1f1f26, #2d1b4e);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .play-icon {
      position: absolute;
      width: 48px;
      height: 48px;
      background: rgba(0, 0, 0, 0.7);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      color: #fff;
      border: 2px solid rgba(255,255,255,0.2);
    }

    .badge {
      position: absolute;
      top: 8px;
      right: 8px;
      background: rgba(0,0,0,0.75);
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 0.72rem;
      text-transform: uppercase;
      font-weight: 700;
    }

    .info { padding: 12px 14px; }
    .title {
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 6px;
      line-height: 1.3;
    }
    .meta {
      font-size: 0.8rem;
      color: var(--muted);
      display: flex;
      justify-content: space-between;
    }

    /* Modal reproductor */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.88);
      z-index: 100;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    .modal.open { display: flex; }

    .modal-content {
      width: 100%;
      max-width: 900px;
      background: var(--card);
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid #2f2f35;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 16px;
      border-bottom: 1px solid #26262c;
    }

    .close-btn {
      background: none;
      border: none;
      color: var(--muted);
      font-size: 1.5rem;
      cursor: pointer;
      line-height: 1;
    }
    .close-btn:hover { color: #fff; }

    .player-wrap {
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #000;
    }
    .player-wrap iframe, .player-wrap video {
      width: 100%;
      height: 100%;
      border: none;
    }
  </style>
</head>
<body>

  <header>
    <div class="top-bar">
      <h1>🎬 Mis <span>Clips</span></h1>
      <input type="text" id="search" placeholder="Buscar clip o categoría...">
    </div>
    <div class="filters" id="filters"></div>
  </header>

  <main class="grid" id="grid"></main>

  <div class="modal" id="modal">
    <div class="modal-content">
      <div class="modal-header">
        <strong id="modalTitle"></strong>
        <button class="close-btn" id="closeModal">&times;</button>
      </div>
      <div class="player-wrap" id="playerWrap"></div>
    </div>
  </div>

  <script>
    // ==========================================
    // AGREGA AQUÍ TUS CLIPS
    // Tipos soportados: "youtube", "twitch", "mp4", "embed"
    // ==========================================
    const clips = [
      {
        title: "Clutch increíble en el último segundo",
        category: "Free Fire",
        date: "19 Nov 2026",
        type: "youtube",
        src: "dQw4w9WgXcQ",
        thumb: ""
      },
      {
        title: "Reacción épica en directo",
        category: "Just Chatting",
        date: "18 Nov 2026",
        type: "twitch",
        src: "ID_DEL_CLIP_DE_TWITCH",
        thumb: ""
      },
      {
        title: "Jugada destacada desde Kick / otro",
        category: "Gaming",
        date: "17 Nov 2026",
        type: "embed",
        src: "https://player.kick.com/tu_canal",
        thumb: ""
      }
    ];

    let activeCategory = "Todos";
    const grid = document.getElementById("grid");
    const filtersEl = document.getElementById("filters");
    const searchInput = document.getElementById("search");
    const modal = document.getElementById("modal");
    const modalTitle = document.getElementById("modalTitle");
    const playerWrap = document.getElementById("playerWrap");

    function renderFilters() {
      const categories = ["Todos", ...new Set(clips.map(c => c.category))];
      filtersEl.innerHTML = categories.map(cat => `
        <button class="filter-btn ${cat === activeCategory ? 'active' : ''}" onclick="setCategory('${cat}')">
          ${cat}
        </button>
      `).join("");
    }

    function setCategory(cat) {
      activeCategory = cat;
      renderFilters();
      renderClips();
    }

    function getThumb(clip) {
      if (clip.thumb) return `<img src="${clip.thumb}" alt="${clip.title}" loading="lazy">`;
      if (clip.type === "youtube") {
        return `<img src="https://img.youtube.com/vi/${clip.src}/hqdefault.jpg" alt="${clip.title}" loading="lazy">`;
      }
      return "";
    }

    function renderClips() {
      const q = searchInput.value.toLowerCase();
      const filtered = clips.filter(c => {
        const matchCat = activeCategory === "Todos" || c.category === activeCategory;
        const matchText = c.title.toLowerCase().includes(q) || c.category.toLowerCase().includes(q);
        return matchCat && matchText;
      });

      grid.innerHTML = filtered.map((clip) => `
        <article class="card" onclick="openClip(${clips.indexOf(clip)})">
          <div class="thumb">
            ${getThumb(clip)}
            <span class="badge">${clip.type}</span>
            <div class="play-icon">▶</div>
          </div>
          <div class="info">
            <div class="title">${clip.title}</div>
            <div class="meta">
              <span>${clip.category}</span>
              <span>${clip.date}</span>
            </div>
          </div>
        </article>
      `).join("");
    }

    function openClip(index) {
      const clip = clips[index];
      modalTitle.textContent = clip.title;
      const host = window.location.hostname || "localhost";

      if (clip.type === "youtube") {
        playerWrap.innerHTML = `<iframe src="https://www.youtube.com/embed/${clip.src}?autoplay=1" allowfullscreen allow="autoplay"></iframe>`;
      } else if (clip.type === "twitch") {
        playerWrap.innerHTML = `<iframe src="https://clips.twitch.tv/embed?clip=${clip.src}&parent=${host}&autoplay=true" allowfullscreen></iframe>`;
      } else if (clip.type === "mp4") {
        playerWrap.innerHTML = `<video src="${clip.src}" controls autoplay></video>`;
      } else {
        playerWrap.innerHTML = `<iframe src="${clip.src}" allowfullscreen></iframe>`;
      }

      modal.classList.add("open");
    }

    function closeModal() {
      modal.classList.remove("open");
      playerWrap.innerHTML = "";
    }

    document.getElementById("closeModal").onclick = closeModal;
    modal.onclick = (e) => { if (e.target === modal) closeModal(); };
    searchInput.oninput = renderClips;

    renderFilters();
    renderClips();
  </script>
</body>
</html>
